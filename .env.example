# Supabase (required from Phase 2 onward — Phase 1 UI runs without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address Sarvam and ads reach this app at (tunnel locally, real domain when deployed)
APP_PUBLIC_URL=

# Call result emails (resend.com). Without a verified domain, leave RESULTS_FROM_EMAIL empty:
# the shared test sender then only delivers to your own Resend account address.
RESEND_API_KEY=
RESULTS_FROM_EMAIL=

# Facebook / Instagram lead ads (developers.facebook.com app). META_VERIFY_TOKEN is any
# random string you also paste into the app's Webhooks setup. META_GRAPH_VERSION is optional.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=

# Protects /api/campaigns/tick, the scheduler that dials campaign contacts.
# Vercel Cron sends it as a Bearer token automatically. Any long random string.
CRON_SECRET=

# Billing. Calls are always charged to the credit ledger; set to true to also stop
# calling for businesses with less than one minute of credit left.
BILLING_ENFORCED=false
