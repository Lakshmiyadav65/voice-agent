# Database
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=ai_employee_dev
POSTGRES_DB=ai_employee
DATABASE_URL=postgresql+asyncpg://ai_employee:ai_employee_dev@localhost:5432/ai_employee

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production-use-a-long-random-string
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Knowledge base
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=20971520
EMBEDDING_DIMENSIONS=384

# Object storage (S3-compatible) — replaces local storage in production
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# AI Providers
#
# Not yet configured. The conversation engine currently runs on the offline
# providers in app/providers/offline.py, which keep the full pipeline testable
# without vendor accounts. Set these to switch to hosted providers.
#
# STT_PROVIDER=
# STT_API_KEY=
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
# TTS_PROVIDER=
# TTS_API_KEY=

# Telephony and WhatsApp — configure before Phases 7 and 8
# TELEPHONY_PROVIDER=
# WHATSAPP_PROVIDER=
